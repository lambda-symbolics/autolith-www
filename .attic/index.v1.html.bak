<meta property="og:title" content="Autolith — a programming agent that can rewrite itself while it runs">
<meta property="og:description" content="A terminal programming agent inside a live Common Lisp image it can inspect, extend, break and recover.">
<meta property="og:type" content="website">
<meta property="og:image" content="og.png">
