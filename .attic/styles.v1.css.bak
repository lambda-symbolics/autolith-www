/* Autolith — Lambda Symbolics OÜ
   Black ink, one off-white substrate, motion.
   Descended from the Interlisp Paper stylesheet; no longer constrained by it. */

/* ---------------------------------------------------------------- fonts */

@font-face{font-family:"TNR";src:url("fonts/times-new-roman-regular.woff2") format("woff2");font-style:normal;font-weight:400;font-display:swap}
@font-face{font-family:"TNR";src:url("fonts/times-new-roman-bold.woff2") format("woff2");font-style:normal;font-weight:700;font-display:swap}
@font-face{font-family:"TNR";src:url("fonts/times-new-roman-italic.woff2") format("woff2");font-style:italic;font-weight:400;font-display:swap}
@font-face{font-family:"TNR";src:url("fonts/times-new-roman-bold-italic.woff2") format("woff2");font-style:italic;font-weight:700;font-display:swap}
@font-face{font-family:"CMUT";src:url("fonts/cmu-typewriter-regular.woff2") format("woff2");font-style:normal;font-weight:400;font-display:swap}
@font-face{font-family:"CMUT";src:url("fonts/cmu-typewriter-bold.woff2") format("woff2");font-style:normal;font-weight:700;font-display:swap}
@font-face{font-family:"CMUT";src:url("fonts/cmu-typewriter-italic.woff2") format("woff2");font-style:italic;font-weight:400;font-display:swap}

/* --------------------------------------------------------------- tokens */

:root{
  --ink:#000000;
  --paper:#fffefa;

  --ember:#e24a32;
  --amber:#efb03c;
  --jade:#3fa971;
  --azure:#5b8fc9;

  --ember-deep:#8a1c1c;
  --amber-deep:#8a6a00;
  --jade-deep:#12633a;
  --azure-deep:#003a70;

  --serif:"TNR",Times,"Nimbus Roman No9 L","Liberation Serif",serif;
  --mono:"CMUT","CMU Typewriter Text","Courier New",Courier,monospace;

  --fg:var(--ink);
  --bg:var(--paper);
  --accent:var(--ember-deep);
  --rule:rgba(0,0,0,.22);
  --rule-soft:rgba(0,0,0,.10);
  --dim:rgba(0,0,0,.68);
  --dimmer:rgba(0,0,0,.50);

  --gut:clamp(20px,5vw,64px);
  --wide:1440px;
  --max:1200px;
  --read:66ch;

  --band-y:clamp(5.5rem,13vh,11rem);

  --ease:cubic-bezier(.22,.61,.36,1);
  --ease-io:cubic-bezier(.65,.02,.25,1);
}

*,*::before,*::after{box-sizing:border-box}

html{
  font-family:var(--serif);
  font-size:17px;
  line-height:1.56;
  color:var(--fg);
  background:var(--bg);
  -webkit-text-size-adjust:100%;
  text-rendering:optimizeLegibility;
  scroll-behavior:smooth;
}
@media (min-width:1500px){html{font-size:18px}}

body{margin:0;background:var(--ink);overflow-x:clip}

::selection{background:var(--fg);color:var(--bg)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:1px}

img,svg,canvas{display:block;max-width:100%}
a{color:inherit}
h1,h2,h3,h4,p,ul,ol,figure,blockquote{margin:0}
ul,ol{padding:0;list-style:none}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}

/* ---------------------------------------------------------- primitives */

.wrap{width:100%;max-width:var(--max);margin-inline:auto;padding-inline:var(--gut)}
.wrap--wide{max-width:var(--wide)}

.band{
  position:relative;
  background:var(--bg);
  color:var(--fg);
  padding-block:var(--band-y);
  isolation:isolate;
}
.band--ink{
  --fg:#fffefa;
  --bg:#000000;
  --accent:var(--amber);
  --rule:rgba(255,254,250,.20);
  --rule-soft:rgba(255,254,250,.09);
  --dim:rgba(255,254,250,.72);
  --dimmer:rgba(255,254,250,.52);
}
.band--paper{--fg:#000000;--bg:#fffefa;--accent:var(--ember-deep);--rule:rgba(0,0,0,.22);--rule-soft:rgba(0,0,0,.10);--dim:rgba(0,0,0,.68);--dimmer:rgba(0,0,0,.50)}
.band--tight{padding-block:clamp(3rem,7vh,5.5rem)}

/* grain + vignette on dark bands */
.band--ink::before{
  content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
  background-image:radial-gradient(rgba(255,254,250,.055) 1px,transparent 1px);
  background-size:3px 3px;
  opacity:.7;
  mix-blend-mode:screen;
}

.label{
  font-family:var(--mono);
  font-size:.70rem;
  letter-spacing:.06em;
  text-transform:none;
  color:var(--dimmer);
  line-height:1.4;
}
.label--accent{color:var(--accent)}

.rule{height:1px;background:var(--rule);border:0;margin:0}

.display{
  font-family:var(--serif);
  font-weight:400;
  letter-spacing:-.022em;
  line-height:.96;
  text-wrap:balance;
}
.display em{font-style:italic;letter-spacing:-.01em}
.d1{font-size:clamp(2.5rem,6.4vw,5.9rem)}
.d2{font-size:clamp(1.95rem,4.4vw,3.7rem);line-height:1.02}
.d3{font-size:clamp(1.6rem,3.1vw,2.5rem);line-height:1.08;letter-spacing:-.015em}

.lede{
  font-size:clamp(1.06rem,1.35vw,1.28rem);
  line-height:1.62;
  color:var(--dim);
  max-width:var(--read);
}
.prose p+p{margin-top:1em}
.prose{max-width:var(--read);color:var(--dim)}
.prose strong{color:var(--fg);font-weight:700}
.prose code,code{font-family:var(--mono);font-size:.92em;color:var(--fg)}

/* section head */
.head{display:grid;gap:clamp(1rem,2.4vw,1.9rem);margin-bottom:clamp(2.5rem,6vh,4.5rem)}
.head__top{display:flex;gap:1rem;align-items:baseline;justify-content:space-between;border-top:1px solid var(--rule);padding-top:.85rem;flex-wrap:wrap}
.head__lede{max-width:62ch}

/* ------------------------------------------------------------- buttons */

.btn{
  --btn-fg:var(--bg);--btn-bg:var(--fg);
  position:relative;display:inline-flex;align-items:center;gap:.6em;
  font-family:var(--mono);font-size:.82rem;letter-spacing:.1em;text-transform:none;
  padding:.95em 1.5em;border:1px solid var(--fg);
  color:var(--btn-fg);background:var(--btn-bg);
  text-decoration:none;overflow:hidden;
  transition:color .35s var(--ease),border-color .35s var(--ease);
  white-space:nowrap;
}
.btn::after{
  content:"";position:absolute;inset:0;background:var(--bg);
  transform:scaleY(0);transform-origin:bottom;
  transition:transform .42s var(--ease-io);z-index:0;
}
.btn>*{position:relative;z-index:1}
.btn:hover::after,.btn:focus-visible::after{transform:scaleY(1)}
.btn:hover,.btn:focus-visible{color:var(--fg)}
.btn--ghost{--btn-fg:var(--fg);--btn-bg:transparent}
.btn--ghost::after{background:var(--fg)}
.btn--ghost:hover,.btn--ghost:focus-visible{color:var(--bg)}
.btn__arrow{font-family:var(--mono);transition:transform .35s var(--ease)}
.btn:hover .btn__arrow{transform:translateX(.3em)}

/* animated underline link */
.ulink{
  text-decoration:none;background-image:linear-gradient(currentColor,currentColor);
  background-size:100% 1px;background-repeat:no-repeat;background-position:0 100%;
  transition:background-size .4s var(--ease-io);
}
.ulink:hover{background-size:0% 1px;background-position:100% 100%}

/* ------------------------------------------------------------- reveals */

.js [data-rv]{opacity:0;transform:translateY(22px);transition:opacity .9s var(--ease),transform .9s var(--ease);transition-delay:calc(var(--d,0)*80ms)}
.js [data-rv].in{opacity:1;transform:none}
.js [data-rv="fade"]{transform:none}
.js [data-rv="clip"]{opacity:1;transform:none;clip-path:inset(0 100% 0 0);transition:clip-path 1.05s var(--ease-io)}
.js [data-rv="clip"].in{clip-path:inset(0 0 0 0)}
.lineclip{display:block;overflow:hidden}
.js .lineclip>span{display:block;transform:translateY(105%);transition:transform 1.05s var(--ease-io);transition-delay:calc(var(--d,0)*90ms)}
.in .lineclip>span,.lineclip.in>span{transform:none}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  [data-rv],[data-rv="clip"]{opacity:1!important;transform:none!important;clip-path:none!important;transition:none!important}
  .lineclip>span{transform:none!important;transition:none!important}
  .marquee__track{animation:none!important}
}

/* ------------------------------------------------------------------ nav */

.nav{
  position:fixed;inset:0 0 auto 0;z-index:60;
  color:var(--paper);
  transition:color .5s var(--ease),background-color .45s var(--ease),border-color .45s var(--ease);
  border-bottom:1px solid transparent;
  mix-blend-mode:normal;
}
.nav.is-paper{color:var(--ink)}
.nav.is-stuck{background:rgba(0,0,0,.80);backdrop-filter:blur(14px) saturate(1.1);border-bottom-color:rgba(255,254,250,.14)}
.nav.is-stuck.is-paper{background:rgba(255,254,250,.86);border-bottom-color:rgba(0,0,0,.14)}
.nav.is-paper{--nav-bg:#fffefa}
.nav:not(.is-paper){--nav-bg:#000000}
.nav__in{display:flex;align-items:center;gap:1.5rem;height:var(--navh,68px);transition:height .4s var(--ease)}
.nav.is-stuck .nav__in{--navh:58px}
.brand{display:flex;align-items:center;gap:.6rem;text-decoration:none;flex:none}
.brand svg{width:19px;height:19px;fill:currentColor;transition:transform .6s var(--ease)}
.brand:hover svg{transform:rotate(-12deg) scale(1.08)}
.brand__name{font-family:var(--mono);font-size:.86rem;letter-spacing:.05em;text-transform:none;font-weight:700}
.brand__ver{font-family:var(--mono);font-size:.64rem;letter-spacing:.12em;opacity:.5;align-self:flex-start;margin-top:.15rem}
.nav__links{display:flex;gap:1.6rem;margin-left:auto;align-items:center}
.nav__links a{font-family:var(--mono);font-size:.76rem;letter-spacing:.035em;text-transform:none;text-decoration:none;opacity:.72;transition:opacity .3s}
.nav__links a:hover{opacity:1}
.nav__cta{
  font-family:var(--mono);font-size:.74rem;letter-spacing:.035em;text-transform:none;
  border:1px solid currentColor;padding:.5em 1em;text-decoration:none;opacity:1!important;
  transition:background-color .3s var(--ease),color .3s var(--ease);
}
.nav__cta:hover{background:currentColor}
.nav__cta:hover span{mix-blend-mode:difference;filter:invert(1)}
.nav__burger{display:none;margin-left:auto;width:44px;height:44px;position:relative}
.nav__burger i{position:absolute;left:11px;right:11px;height:1.5px;background:currentColor;transition:transform .4s var(--ease),opacity .3s}
.nav__burger i:nth-child(1){top:17px}
.nav__burger i:nth-child(2){bottom:17px}
body.menu-open .nav__burger i:nth-child(1){transform:translateY(4.5px) rotate(45deg)}
body.menu-open .nav__burger i:nth-child(2){transform:translateY(-4.5px) rotate(-45deg)}

.menu{
  position:fixed;inset:0;z-index:55;background:var(--ink);color:var(--paper);
  display:flex;flex-direction:column;justify-content:center;
  padding:6rem var(--gut) 3rem;
  clip-path:inset(0 0 100% 0);transition:clip-path .7s var(--ease-io);
  pointer-events:none;
}
body.menu-open .menu{clip-path:inset(0 0 0 0);pointer-events:auto}
.menu a{
  font-family:var(--serif);font-size:clamp(2rem,9vw,3.4rem);line-height:1.18;
  text-decoration:none;display:block;opacity:0;transform:translateY(20px);
  transition:opacity .5s var(--ease),transform .5s var(--ease);
}
body.menu-open .menu a{opacity:1;transform:none;transition-delay:calc(var(--d)*60ms + 180ms)}
.menu__foot{margin-top:2.5rem;display:flex;gap:1.2rem;flex-wrap:wrap}
.menu__foot a{font-family:var(--mono);font-size:.78rem;letter-spacing:.04em;text-transform:none;opacity:.6}

@media (max-width:900px){
  .nav__links{display:none}
  .nav__burger{display:block}
}
@media (min-width:901px){.menu{display:none}}

/* ----------------------------------------------------------------- hero */

.hero{
  position:relative;min-height:100svh;display:flex;flex-direction:column;
  background:var(--ink);color:var(--paper);
  --fg:#fffefa;--bg:#000000;--accent:var(--amber);
  --rule:rgba(255,254,250,.20);--rule-soft:rgba(255,254,250,.09);
  --dim:rgba(255,254,250,.72);--dimmer:rgba(255,254,250,.52);
  overflow:hidden;
}
#monolith{position:absolute;inset:0;width:100%;height:100%;z-index:0;opacity:0;transition:opacity 1.1s ease}
#monolith.ready{opacity:1}
.hero__veil{
  position:absolute;inset:0;z-index:1;pointer-events:none;
  background:
    linear-gradient(100deg,rgba(0,0,0,.96) 0%,rgba(0,0,0,.93) 30%,rgba(0,0,0,.62) 46%,rgba(0,0,0,.12) 62%,rgba(0,0,0,0) 76%),
    linear-gradient(to bottom,rgba(0,0,0,.8) 0%,rgba(0,0,0,0) 18%,rgba(0,0,0,0) 68%,rgba(0,0,0,.9) 100%);
}
.hero__grain{
  position:absolute;inset:0;z-index:2;pointer-events:none;opacity:.5;
  background-image:radial-gradient(rgba(255,254,250,.07) 1px,transparent 1px);
  background-size:3px 3px;mix-blend-mode:screen;
}
.hero__in{position:relative;z-index:3;flex:1;display:flex;flex-direction:column;justify-content:center;padding-block:clamp(5rem,11vh,7rem) clamp(1rem,2.5vh,1.8rem)}
.hero__eyebrow{display:flex;gap:.85rem;align-items:center;flex-wrap:wrap;margin-bottom:clamp(1.3rem,3vh,2.2rem)}
.hero__eyebrow .dot{width:5px;height:5px;background:var(--amber);border-radius:50%;box-shadow:0 0 0 0 rgba(239,176,60,.7);animation:pulse 2.6s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(239,176,60,.55)}70%{box-shadow:0 0 0 9px rgba(239,176,60,0)}100%{box-shadow:0 0 0 0 rgba(239,176,60,0)}}
.hero h1{max-width:19ch}
.hero h1 em{color:var(--paper)}
.hero h1 .glow{position:relative}
.hero__lede{margin-top:clamp(1.2rem,2.6vh,1.9rem);max-width:56ch;font-size:clamp(1.04rem,1.32vw,1.26rem);color:rgba(255,254,250,.68);line-height:1.62}
.hero__acts{margin-top:clamp(1.4rem,3vh,2.2rem);display:flex;gap:.85rem;flex-wrap:wrap;align-items:center}

.hero__stats{
  position:relative;z-index:3;border-top:1px solid rgba(255,254,250,.16);
  display:grid;grid-template-columns:repeat(4,1fr);
}
.hero__stats li{padding:clamp(.85rem,1.8vh,1.3rem) 0 clamp(1rem,2vh,1.5rem);padding-right:1.2rem;border-left:1px solid rgba(255,254,250,.13);padding-left:1.2rem}
.hero__stats li:first-child{border-left:0;padding-left:0}
.hero__stats b{display:block;font-family:var(--serif);font-size:clamp(1.4rem,2.6vw,2.1rem);font-weight:400;line-height:1;letter-spacing:-.02em}
.hero__stats span{display:block;margin-top:.45rem;font-family:var(--mono);font-size:.68rem;letter-spacing:.09em;text-transform:none;color:rgba(255,254,250,.46);line-height:1.5}
@media (max-width:820px){
  .hero__stats{grid-template-columns:1fr 1fr}
  .hero__stats li:nth-child(3){border-left:0;padding-left:0}
  .hero__stats li:nth-child(-n+2){border-bottom:1px solid rgba(255,254,250,.13)}
}

.scrollcue{position:absolute;bottom:calc(100% + .9rem);right:var(--gut);display:flex;align-items:center;gap:.6rem;font-family:var(--mono);font-size:.64rem;letter-spacing:.05em;text-transform:none;color:rgba(255,254,250,.4)}
.scrollcue i{display:block;width:1px;height:30px;background:linear-gradient(rgba(255,254,250,.5),transparent);animation:cue 2.2s var(--ease) infinite}
@keyframes cue{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
@media (max-width:700px){.scrollcue{display:none}}

/* ------------------------------------------------------------ terminal */

.term{
  font-family:var(--mono);
  background:#050505;color:#e9e6df;--dimmer:rgba(233,230,223,.45);
  border:1px solid rgba(255,254,250,.15);
  font-size:clamp(.72rem,1.05vw,.87rem);
  line-height:1.72;
  position:relative;
}
.band--paper .term{border-color:rgba(0,0,0,.2)}
.term--paper{--dimmer:rgba(0,0,0,.46);background:var(--paper);color:var(--ink);border-color:rgba(0,0,0,.2)}
.term--paper .term__bar{border-bottom-color:rgba(0,0,0,.16);color:rgba(0,0,0,.46)}
.term--paper .term__bar .dots i{border-color:rgba(0,0,0,.35)}
.term__bar{
  display:flex;align-items:center;gap:.6rem;
  padding:.55rem .9rem;border-bottom:1px solid rgba(255,254,250,.14);
  font-size:.66rem;letter-spacing:.04em;text-transform:none;color:rgba(233,230,223,.45);
}
.term__bar .dots{display:flex;gap:5px}
.term__bar .dots i{width:7px;height:7px;border:1px solid rgba(233,230,223,.4);border-radius:50%}
.term__body{padding:clamp(.9rem,2vw,1.5rem);overflow-x:auto}
.term__body pre{margin:0;font:inherit;white-space:pre}
.c-dim{color:var(--dimmer)}
.term .c-dim{color:var(--dimmer)}
.c-amber{color:var(--amber)}
.c-ember{color:var(--ember)}
.c-jade{color:var(--jade)}
.c-azure{color:var(--azure)}
.c-paper{color:#fffefa}

/* install strip */
.install{
  display:flex;align-items:stretch;gap:0;border:1px solid rgba(255,254,250,.22);
  font-family:var(--mono);max-width:640px;background:rgba(255,254,250,.03);
}
.band--paper .install{border-color:rgba(0,0,0,.24);background:rgba(0,0,0,.02)}
.install code{
  flex:1;padding:.9em 1.05em;font-size:clamp(.7rem,1.05vw,.83rem);
  white-space:nowrap;overflow-x:auto;color:inherit;
  scrollbar-width:none;
}
.install code::-webkit-scrollbar{display:none}
.install code .p{color:var(--accent)}
.install__copy{
  flex:none;padding:0 1.1em;border-left:1px solid rgba(255,254,250,.22);
  font-size:.68rem;letter-spacing:.04em;text-transform:none;
  transition:background-color .3s,color .3s;
}
.band--paper .install__copy{border-left-color:rgba(0,0,0,.24)}
.install__copy:hover{background:var(--fg);color:var(--bg)}
.install__copy.ok{color:var(--jade)}
.install__note{margin-top:.7rem;font-family:var(--mono);font-size:.68rem;letter-spacing:.06em;color:var(--dimmer)}

/* -------------------------------------------------------------- marquee */

.marquee{
  border-block:1px solid var(--rule);
  padding-block:.9rem;overflow:hidden;position:relative;
  --mq-dur:52s;
}
.marquee__track{display:flex;width:max-content;animation:mq var(--mq-dur) linear infinite;will-change:transform}
.marquee:hover .marquee__track{animation-play-state:paused}
.marquee__track span{
  font-family:var(--mono);font-size:.76rem;letter-spacing:.05em;text-transform:none;
  padding-inline:1.6rem;white-space:nowrap;color:var(--dim);
  display:flex;align-items:center;gap:1.6rem;
}
.marquee__track span::after{content:"";width:4px;height:4px;background:var(--accent);border-radius:50%;flex:none}
@keyframes mq{to{transform:translateX(-50%)}}

/* --------------------------------------------------------------- pillars */

.pillars{border-top:1px solid var(--rule)}
.pillar{
  display:grid;grid-template-columns:5.5rem minmax(0,1fr) minmax(0,1.15fr);
  gap:clamp(1rem,3vw,2.5rem);align-items:start;
  padding-block:clamp(1.6rem,3.6vh,2.6rem);
  border-bottom:1px solid var(--rule);
  position:relative;
}
.pillar::before{
  content:"";position:absolute;inset:0;background:var(--fg);
  transform:scaleY(0);transform-origin:bottom;z-index:-1;
  transition:transform .5s var(--ease-io);
}
.pillar:hover::before{transform:scaleY(1);transform-origin:top}
.pillar:hover{color:var(--bg)}
.pillar:hover .pillar__num,.pillar:hover .pillar__body{color:color-mix(in srgb,var(--bg) 72%,transparent)}
.pillar:hover .pillar__mark{opacity:1;transform:none}
.pillar__num{font-family:var(--mono);font-size:.76rem;letter-spacing:.04em;color:var(--dimmer);padding-top:.55rem;transition:color .4s}
.pillar__t{font-size:clamp(1.5rem,3vw,2.2rem);line-height:1.1;letter-spacing:-.018em}
.pillar__body{color:var(--dim);max-width:46ch;padding-top:.35rem;transition:color .4s}
.pillar__mark{
  font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;
  opacity:0;transform:translateX(-8px);transition:opacity .4s var(--ease),transform .4s var(--ease);
  margin-top:.5rem;display:block;
}
.pillar:hover{padding-inline:clamp(.5rem,1.6vw,1.4rem)}
.pillar{transition:padding .5s var(--ease-io),color .4s}
@media (max-width:860px){
  .pillar{grid-template-columns:3.2rem minmax(0,1fr);gap:1rem}
  .pillar__body{grid-column:2}
}

/* ------------------------------------------------------ scrubbed stages */

.scrub{position:relative}
.scrub__sticky{position:sticky;top:0;min-height:100svh;display:flex;align-items:center;overflow:hidden}

/* desugar */
.sugar{display:grid;gap:clamp(1.6rem,4vh,3rem);width:100%}
.sugar__stage{
  position:relative;font-family:var(--mono);
  font-size:clamp(.78rem,2.55vw,1.7rem);
  line-height:1.8;min-height:2.6em;
  white-space:nowrap;overflow:visible;
}
.sugar__glyphs{position:relative;display:block;height:1.8em}
.sugar__glyphs b{
  position:absolute;top:0;left:0;font-weight:400;
  will-change:transform,opacity;
  transition:opacity .28s linear,color .45s linear;
}
.sugar__steps{display:flex;gap:0;border-top:1px solid var(--rule);flex-wrap:wrap}
.sugar__step{
  flex:1 1 200px;padding:1rem 1.1rem 1rem 0;border-right:1px solid var(--rule);
  padding-right:1.4rem;position:relative;opacity:.32;transition:opacity .5s var(--ease);
}
.sugar__step:last-child{border-right:0}
.sugar__step.on{opacity:1}
.sugar__step::before{
  content:"";position:absolute;top:-1px;left:0;height:1px;width:0;background:var(--accent);
  transition:width .6s var(--ease-io);
}
.sugar__step.on::before{width:100%}
.sugar__step h4{font-family:var(--mono);font-size:.72rem;letter-spacing:.04em;text-transform:none;margin-bottom:.45rem}
.sugar__step p{font-size:.94rem;color:var(--dim);line-height:1.5;max-width:34ch}

/* ------------------------------------------------------- mutation ladder */

.ladder{font-family:var(--mono);font-size:clamp(.72rem,1.02vw,.85rem);line-height:1.9}
.ladder li{
  display:grid;grid-template-columns:1.6rem 1fr;gap:.5rem;
  opacity:0;transform:translateX(-10px);
  transition:opacity .5s var(--ease),transform .5s var(--ease);
  padding-block:.08rem;
}
.ladder li.on{opacity:1;transform:none}
.ladder .ar{color:var(--accent)}
.ladder .re{color:var(--dimmer)}
.ladder li.re-line .ar{color:var(--dimmer)}

.crash{
  position:relative;border:1px solid var(--rule);
  transition:border-color .3s;
}
.crash.boom{animation:boom .55s steps(2) 1;border-color:var(--ember)}
@keyframes boom{
  0%,100%{filter:none;transform:none}
  20%{filter:invert(1);transform:translate(3px,-2px)}
  40%{filter:invert(1) hue-rotate(90deg);transform:translate(-4px,2px)}
  60%{filter:none;transform:translate(2px,1px)}
  80%{filter:invert(1);transform:none}
}
.recovery{
  border:1px solid var(--rule);padding:clamp(1rem,2.4vw,1.6rem);background:var(--bg);
  opacity:0;transform:translateY(14px);
  transition:opacity .7s var(--ease),transform .7s var(--ease);
}
.recovery.on{opacity:1;transform:none;border-color:var(--jade-deep)}
.band--ink .recovery.on{border-color:var(--jade)}

/* ------------------------------------------------------------- rlm tree */

.rlm{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:clamp(2rem,5vw,4.5rem);align-items:center}
@media (max-width:940px){.rlm{grid-template-columns:1fr}}
.rlm__viz{position:relative;width:100%;aspect-ratio:1/.82;min-height:280px}
.rlm__viz svg{width:100%;height:100%;overflow:visible}
.rlm__viz .edge{fill:none;stroke:var(--rule);stroke-width:1;stroke-dasharray:var(--len,400);stroke-dashoffset:var(--len,400);transition:stroke-dashoffset .8s var(--ease-io),stroke .6s}
.rlm__viz .edge.on{stroke-dashoffset:0;stroke:rgba(239,176,60,.42)}
.rlm__viz .edge.dash{stroke-width:1;opacity:.7}
.rlm__viz .edge.dash.on{stroke:var(--dimmer);stroke-dasharray:4 4!important;stroke-dashoffset:0}

.rlm__viz .caps{opacity:0;transition:opacity .8s var(--ease)}
.rlm__viz .caps.on{opacity:1}
.rlm__viz .caps text{font-family:var(--mono);fill:var(--dim);letter-spacing:.04em}

.rlm__viz .node{opacity:0;transform-box:fill-box;transform-origin:center;transform:scale(.35);
  transition:opacity .55s var(--ease),transform .6s var(--ease)}
.rlm__viz .node.on{opacity:1;transform:none}
.rlm__viz .node text{font-family:var(--mono);fill:var(--dimmer)}
.rlm__viz .node .big{fill:var(--fg)}

.rlm__viz .corpus rect{fill:none;stroke:var(--rule);stroke-width:1}
.rlm__viz .corpus{transform-origin:center}

.rlm__viz .root circle{fill:var(--fg);stroke:none}
.rlm__viz .root text{fill:var(--bg)}
.rlm__viz .root.ret circle{fill:var(--amber)}
.rlm__viz .root circle{transition:fill .5s var(--ease)}

.rlm__viz .frame circle{fill:var(--bg);stroke:var(--fg);stroke-width:1.2;transition:fill .5s var(--ease),stroke .5s var(--ease)}
.rlm__viz .frame.ret circle{fill:rgba(239,176,60,.85);stroke:var(--amber)}

.rlm__viz .leaf circle{fill:none;stroke:var(--dimmer);stroke-width:1;transition:fill .45s var(--ease),stroke .45s var(--ease)}
.rlm__viz .leaf.lit circle{fill:var(--amber);stroke:var(--amber)}

.meters{display:grid;gap:1.1rem;margin-top:clamp(1.6rem,4vh,2.6rem)}
.meter__top{display:flex;justify-content:space-between;font-family:var(--mono);font-size:.7rem;letter-spacing:.035em;text-transform:none;margin-bottom:.42rem;color:var(--dimmer)}
.meter__top b{color:var(--fg);font-weight:400}
.meter__bar{height:3px;background:var(--rule-soft);position:relative;overflow:hidden}
.meter__bar i{position:absolute;inset:0 auto 0 0;width:0;background:var(--accent);transition:width 1.1s var(--ease-io)}

.facts{border-top:1px solid var(--rule);margin-top:clamp(2rem,5vh,3.2rem)}
.facts div{display:grid;grid-template-columns:minmax(9rem,.5fr) 1fr;gap:1rem;padding-block:.85rem;border-bottom:1px solid var(--rule-soft);align-items:baseline}
.facts dt{font-family:var(--mono);font-size:.7rem;letter-spacing:.04em;text-transform:none;color:var(--dimmer)}
.facts dd{margin:0;font-size:.98rem;color:var(--fg)}
.facts dd small{color:var(--dim);font-size:.86em}
@media (max-width:620px){.facts div{grid-template-columns:1fr;gap:.25rem}}

/* --------------------------------------------------------------- demos */

.demos__tabs{display:flex;gap:0;border-bottom:1px solid var(--rule);flex-wrap:wrap;margin-bottom:0}
.demos__tabs button{
  font-family:var(--mono);font-size:.74rem;letter-spacing:.04em;text-transform:none;
  padding:.95em 1.3em;border-bottom:2px solid transparent;margin-bottom:-1px;color:var(--dimmer);
  transition:color .3s,border-color .3s;
}
.demos__tabs button:hover{color:var(--fg)}
.demos__tabs button[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--accent)}
.demo{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:clamp(1.5rem,3.5vw,3rem);padding-top:clamp(1.6rem,4vh,2.6rem)}
@media (max-width:940px){.demo{grid-template-columns:1fr}}
.demo[hidden]{display:none}
.player{position:relative;background:#050505;border:1px solid var(--rule);aspect-ratio:16/10;overflow:hidden}
.player__poster{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;background:#050505;z-index:2;transition:opacity .5s}
.player__poster pre{font-family:var(--mono);font-size:clamp(.42rem,1vw,.62rem);color:rgba(233,230,223,.34);line-height:1.25;margin:0}
.player__poster.gone{opacity:0;pointer-events:none}
.player__load{border:1px solid rgba(255,254,250,.4);color:#fffefa;padding:.75em 1.3em;font-family:var(--mono);font-size:.72rem;letter-spacing:.04em;text-transform:none;transition:background-color .3s,color .3s}
.player__load:hover{background:#fffefa;color:#000}
.player .ap-player{position:absolute;inset:0}
.demo__meta dt{font-family:var(--mono);font-size:.66rem;letter-spacing:.04em;text-transform:none;color:var(--dimmer);margin-top:1rem}
.demo__meta dt:first-child{margin-top:0}
.demo__meta dd{margin:.3rem 0 0;font-size:.94rem;line-height:1.55;color:var(--dim)}
.demo__meta dd b{color:var(--fg);font-weight:400}
.demo__meta code{font-size:.86em}

/* ---------------------------------------------------------------- bento */

.bento{display:grid;grid-template-columns:repeat(12,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule)}
.cell{background:var(--bg);padding:clamp(1.2rem,2.6vw,2rem);display:flex;flex-direction:column;gap:.7rem;position:relative;overflow:hidden;transition:background-color .45s var(--ease)}
.cell:hover{background:rgba(0,0,0,.045)}
.band--ink .cell:hover{background:rgba(255,254,250,.06)}
.cell h3{font-size:clamp(1.1rem,1.8vw,1.4rem);line-height:1.16;letter-spacing:-.012em}
.cell p{font-size:.94rem;line-height:1.55;color:var(--dim)}
.cell__n{font-family:var(--mono);font-size:.66rem;letter-spacing:.05em;color:var(--dimmer)}
.cell--4{grid-column:span 4}
.cell--6{grid-column:span 6}
.cell--8{grid-column:span 8}
.cell--12{grid-column:span 12}
.cell__glyph{display:none}
.cell:hover .cell__glyph{transform:translateY(-6px) rotate(-6deg);color:rgba(138,28,28,.38)}
@media (max-width:940px){.cell--4,.cell--6,.cell--8{grid-column:span 6}}
@media (max-width:620px){.cell--4,.cell--6,.cell--8{grid-column:span 12}}

/* -------------------------------------------------------------- process */

.proc{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:clamp(2rem,5vw,4rem);align-items:center}
@media (max-width:940px){.proc{grid-template-columns:1fr}}
.imagebox{border:1px solid var(--rule);padding:clamp(.9rem,2vw,1.4rem);position:relative;background:var(--bg)}
.imagebox__t{font-family:var(--mono);font-size:.66rem;letter-spacing:.05em;text-transform:none;color:var(--dimmer);margin-bottom:.9rem;display:flex;justify-content:space-between}
.imagebox__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule)}
.imagebox__grid i{
  background:var(--bg);padding:.85rem .7rem;font-family:var(--mono);font-style:normal;
  font-size:.7rem;letter-spacing:.05em;color:var(--dim);text-align:center;line-height:1.35;
  min-height:3.6rem;display:flex;align-items:center;justify-content:center;
  transition:background-color .4s,color .4s;
}
.imagebox__grid i.lit{background:var(--accent);color:var(--bg)}
@media (max-width:520px){.imagebox__grid{grid-template-columns:repeat(2,1fr)}}
.imagebox__foot{margin-top:.9rem;font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;color:var(--dimmer);text-align:center}

/* -------------------------------------------------------------- install */

.tabs{display:flex;border:1px solid var(--rule);width:max-content;max-width:100%;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabs button{
  font-family:var(--mono);font-size:.72rem;letter-spacing:.04em;text-transform:none;
  padding:.8em 1.2em;border-right:1px solid var(--rule);white-space:nowrap;
  color:var(--dimmer);transition:background-color .3s,color .3s;
}
.tabs button:last-child{border-right:0}
.tabs button[aria-selected="true"]{background:var(--fg);color:var(--bg)}
.panel[hidden]{display:none}
.panel{padding-top:clamp(1.4rem,3vh,2.2rem)}
.shellblock{font-family:var(--mono);white-space:pre;font-size:clamp(.72rem,1vw,.84rem);line-height:2;border:1px solid var(--rule);padding:clamp(1rem,2.2vw,1.5rem);overflow-x:auto;background:rgba(0,0,0,.028)}
.shellblock .p{color:var(--accent);user-select:none}
.shellblock .c{color:var(--dimmer)}

.warn{position:relative;padding-left:1.5rem;max-width:58ch;color:var(--dim);font-size:.96rem;line-height:1.6}
.warn::before{content:"";position:absolute;left:0;top:.52em;width:9px;height:9px;background:var(--accent)}
.warn+.warn{margin-top:1.15rem}
.warn--note::before{background:var(--amber-deep)}

.platforms{display:flex;flex-wrap:wrap;gap:.5rem}
.platforms li{font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;border:1px solid var(--rule);padding:.5em .9em;color:var(--dim);transition:border-color .3s,color .3s}
.platforms li:hover{border-color:var(--accent);color:var(--fg)}

.providers{display:flex;flex-wrap:wrap;gap:.4rem .5rem}
.providers li{font-family:var(--mono);font-size:.74rem;color:var(--dimmer)}
.providers li::after{content:"·";margin-left:.5rem;color:var(--rule)}
.providers li:last-child::after{content:""}

/* --------------------------------------------------------------- footer */

.foot{background:var(--ink);color:var(--paper);--fg:#fffefa;--bg:#000000;--accent:var(--amber);--rule:rgba(255,254,250,.20);--rule-soft:rgba(255,254,250,.09);--dim:rgba(255,254,250,.72);--dimmer:rgba(255,254,250,.52);padding-block:clamp(3.5rem,9vh,6rem) 2.5rem}
.foot__grid{display:grid;grid-template-columns:minmax(0,1.6fr) repeat(3,minmax(0,1fr));gap:clamp(1.6rem,4vw,3rem);padding-bottom:clamp(2.5rem,6vh,4rem);border-bottom:1px solid rgba(255,254,250,.15)}
@media (max-width:860px){.foot__grid{grid-template-columns:1fr 1fr}.foot__brand{grid-column:1/-1}}
.foot h4{font-family:var(--mono);font-size:.68rem;letter-spacing:.05em;text-transform:none;color:rgba(255,254,250,.42);margin-bottom:1rem}
.foot li{margin-bottom:.55rem}
.foot li a{font-size:.98rem;text-decoration:none;color:rgba(255,254,250,.8);transition:color .3s}
.foot li a:hover{color:var(--amber)}
.foot__mark{font-family:var(--serif);font-size:clamp(2.2rem,6vw,3.6rem);line-height:1;letter-spacing:-.02em;margin-bottom:1rem}
.foot__bottom{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding-top:1.6rem;font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:none;color:rgba(255,254,250,.38)}

/* big closing wordmark */
.closer{overflow:hidden;border-top:1px solid rgba(255,254,250,.15);padding-block:clamp(1rem,3vh,2rem) 0}
.closer svg{width:100%;height:auto;display:block;fill:rgba(255,254,250,.1)}

/* ------------------------------------------------------------ utilities */

.stack-1{display:grid;gap:.5rem}
.stack-2{display:grid;gap:1rem}
.stack-3{display:grid;gap:1.6rem}
.stack-4{display:grid;gap:clamp(1.6rem,4vh,2.6rem)}
.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(1.6rem,4vw,3.5rem)}
@media (max-width:860px){.two{grid-template-columns:1fr}}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:12px;top:12px;z-index:99;background:var(--paper);color:var(--ink);border:1px solid var(--ink);padding:.5em .9em;transform:translateY(-250%);font-family:var(--mono);font-size:.75rem}
.skip:focus{transform:none}

/* ------------------------------------------- the dithered shadow band
   The house depth cue: a 3px grid of ink dots offset behind an object.
   Inverted on dark bands so the dots read as paper. */

:root{--dither:radial-gradient(var(--ink) 1px,transparent 1px)}
.band--ink,.hero,.foot{--dither:radial-gradient(rgba(255,254,250,.55) 1px,transparent 1px)}

.shadowband{position:relative;background:var(--bg)}
.shadowband::after{
  content:"";position:absolute;inset:14px -14px -14px 14px;z-index:-1;
  background-image:var(--dither);background-size:3px 3px;pointer-events:none;
  opacity:0;transform:translate(-8px,-8px);
  transition:opacity .8s var(--ease) .15s,transform .8s var(--ease) .15s;
}
.shadowband.in::after,.in .shadowband::after{opacity:1;transform:none}
@media (max-width:620px){.shadowband::after{inset:9px -9px -9px 9px}}

/* ------------------------------------------------------------- mascot */

.mascot{position:relative;align-self:start;max-width:340px;justify-self:end;width:100%}
.mascot__bar{
  background:var(--fg);color:var(--bg);font-family:var(--mono);font-size:.72rem;
  padding:.42em .7em;display:flex;justify-content:space-between;gap:1rem;
}
.mascot__frame{border:1px solid var(--fg);border-top:0;padding:0;background:var(--bg)}
.mascot__frame img{width:100%;height:auto;display:block;mix-blend-mode:multiply}
.band--ink .mascot__frame img{mix-blend-mode:screen;filter:invert(1)}
.headwrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.42fr);gap:clamp(1.5rem,4vw,3.5rem);align-items:start}
@media (max-width:860px){.headwrap{grid-template-columns:1fr}.mascot{max-width:260px;justify-self:start}}

/* ------------------------------------------------------- misc fixes */

.cell--3{grid-column:span 3}
@media (max-width:940px){.cell--3{grid-column:span 6}}
@media (max-width:620px){.cell--3{grid-column:span 12}}

.hero__statwrap{position:relative;z-index:3}
.brand__name{letter-spacing:.02em}
.label{letter-spacing:.05em}
.lineclip>span em{font-style:italic}
.sugar__glyphs b{white-space:pre}

/* keep the sticky scrub readable on short viewports */
@media (max-height:620px){
  .scrub__sticky{min-height:100svh;align-items:flex-start;padding-top:5rem}
  .sugar__stage{font-size:clamp(.7rem,2.3vw,1.2rem)}
}

/* nav contrast helper */
.nav__cta:hover{background:currentColor}
.nav.is-paper .nav__cta:hover span{color:var(--paper)}
.nav:not(.is-paper) .nav__cta:hover span{color:var(--ink)}
.nav__cta:hover span{mix-blend-mode:normal;filter:none}

/* selection inside dark bands */
.band--ink ::selection,.hero ::selection,.foot ::selection{background:var(--amber);color:#000}

/* static capture mode */
.still [data-rv],.still [data-rv="clip"]{opacity:1!important;transform:none!important;clip-path:none!important;transition:none!important}
.still .lineclip>span{transform:none!important;transition:none!important}
.still .ladder li,.still .sugar__step{opacity:1!important;transform:none!important}
.still .recovery{opacity:1!important;transform:none!important}
.still .shadowband::after{opacity:1!important;transform:none!important}
.still .marquee__track{animation:none!important}

@media (max-width:820px){
  .hero__veil{background:
    linear-gradient(to bottom,rgba(0,0,0,.92) 0%,rgba(0,0,0,.72) 26%,rgba(0,0,0,.55) 55%,rgba(0,0,0,.92) 100%)}
}
.still #monolith{opacity:1!important;transition:none!important}
html.still{scroll-behavior:auto}

.still .meter__bar i{transition:none!important}
.still .rlm__viz .edge{transition:none!important}
.still .rlm__viz .node{transition:none!important}

/* ------------------------------------------------------ small screens */

.install code{min-width:0}
.install{max-width:100%}

@media (max-width:940px){
  .rlm__viz .caps{display:none}
  .rlm__viz{aspect-ratio:1/.78;min-height:250px}
}
@media (max-width:860px){
  .pillar__mark{display:none}
  .pillar:hover{padding-inline:0}
  .pillar::before{display:none}
  .pillar:hover{color:inherit}
  .pillar:hover .pillar__num,.pillar:hover .pillar__body{color:var(--dimmer)}
  .pillar:hover .pillar__body{color:var(--dim)}
}
@media (max-width:820px){
  .hero__veil{background:
    linear-gradient(to bottom,rgba(0,0,0,.94) 0%,rgba(0,0,0,.84) 28%,rgba(0,0,0,.7) 58%,rgba(0,0,0,.94) 100%)}
}
@media (max-width:560px){
  .hero__eyebrow .sep{display:none}
  .hero__eyebrow{gap:.35rem .9rem}
  .btn{width:100%;justify-content:space-between}
  .hero__acts{gap:.6rem}
  .demos__tabs button{padding:.8em 1em}
}
