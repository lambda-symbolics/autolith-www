;; Copy for the hero section. Inline markup: (:em () "text").
(:hero__name
 ("Autolith")
:display
 ("The agent that rewrites " (:em nil "itself") " while it runs.")
:hero__lede
 (" A terminal programming agent inside a live Common Lisp image it can read, edit, break, and recover. ")
:hero__plat
 ("Linux, macOS, FreeBSD, NetBSD, OpenBSD, and Windows. "
  (:a (:class "ulink" :href "#install") "See more."))
)
